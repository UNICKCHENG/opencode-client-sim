{
  "name": "@unickcheng/opencode-client-sim",
  "version": "0.1.0",
  "description": "An OpenCode provider plugin that wears a coding client's clothes for relay sites that only serve Codex CLI or Claude Code requests",
  "type": "module",
  "main": "./index.mjs",
  "exports": "./index.mjs",
  "files": [
    "index.mjs",
    "README.md"
  ],
  "scripts": {
    "test": "bun test"
  },
  "keywords": [
    "magpie-plugin",
    "codex",
    "claude-code"
  ],
  "magpie": {
    "options": {
      "enabled": true,
      "codex": {
        "clientVersion": "0.162.1"
      },
      "claude-code": {
        "clientVersion": "2.1.296"
      }
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UNICKCHENG/opencode-client-sim"
  }
}
